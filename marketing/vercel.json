{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo no-build",
  "installCommand": "echo no-install",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    { "source": "/terms",        "destination": "https://app.thetradevoice.com/legal/terms",   "permanent": true },
    { "source": "/terms.html",   "destination": "https://app.thetradevoice.com/legal/terms",   "permanent": true },
    { "source": "/privacy",      "destination": "https://app.thetradevoice.com/legal/privacy", "permanent": true },
    { "source": "/privacy.html", "destination": "https://app.thetradevoice.com/legal/privacy", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" }
      ]
    }
  ]
}
